# Production environment for EOPP. Copy to infra/.env ON THE SERVER.
# Never commit the real file: it holds the database password and the secret key.
#
# Generate the secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=
# `localhost` and `127.0.0.1` must stay: the web container's healthcheck curls
# localhost:8000, and a DisallowedHost there leaves the container unhealthy —
# which Traefik treats as absent, so every route 404s.
DJANGO_ALLOWED_HOSTS=eopp.johnsonmwebaze.info,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://eopp.johnsonmwebaze.info

DB_NAME=eopp
DB_USER=eopp
DB_PASSWORD=

MINIO_ROOT_USER=eopp
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=eopp

# The host already runs several applications; these are this one's allocation.
# Both bind the loopback — Apache terminates TLS and proxies to them.
TRAEFIK_HTTP_PORT=8007
MINIO_CONSOLE_PORT=8008
IMAGE_TAG=eopp-web

# Optional.
SENTRY_DSN=

# --- Metabase (spec §8, Sprint 7) -----------------------------------------
# Off until enabled: set COMPOSE_PROFILES=bi after provisioning (steps below).
# COMPOSE_PROFILES=bi

# verify with `provision_metabase --check`, then `manage.py build_metabase_dashboards`.
METABASE_RO_PASSWORD=
METABASE_ADMIN_EMAIL=
METABASE_ADMIN_PASSWORD=
# Optional overrides (defaults: bi / metabase_ro / metabase_app / 8009)
# BI_SCHEMA=
# METABASE_RO_ROLE=
# METABASE_APP_DB=
# METABASE_BIND=127.0.0.1   # dev only: 0.0.0.0 exposes an unscoped BI tool to the network
# METABASE_HOST_PORT=8009
# METABASE_SITE_URL=
