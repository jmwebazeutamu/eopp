# Copy to infra/.env and fill in. infra/.env is git-ignored.
# Every variable below is required — the compose files use ${VAR:?...} so a
# missing value stops the stack rather than falling back to a placeholder.

# --- Django ---------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.2.3
DJANGO_LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------
DB_NAME=yep
DB_USER=yep
DB_PASSWORD=
DB_HOST_PORT=5407

# --- Redis ----------------------------------------------------------------
REDIS_HOST_PORT=6307

# --- MinIO (object storage, spec §2 — stays in-country) -------------------
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=yep-media
MINIO_CONSOLE_PORT=8008

# --- Traefik --------------------------------------------------------------
TRAEFIK_HTTP_PORT=8007

# --- Build ----------------------------------------------------------------
BACKEND_REQUIREMENTS=development
IMAGE_TAG=latest

# --- CORS (Vite dev server) ----------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:8100,http://127.0.0.1:8100

# --- Business rule thresholds (spec §11 — placeholders pending Phase 1) ---
STALL_ALERT_THRESHOLD_DAYS=30
REFERRAL_CONFIRMATION_OVERDUE_DAYS=7
CASELOAD_CEILING=50

# --- Production only ------------------------------------------------------
# CSRF_TRUSTED_ORIGINS=https://yep.example.et
# SENTRY_DSN=
